{
  "name": "orbit-sys-dev/laravel-dev-docs-viewer",
  "description": "Docs viewer dashboard for Laravel projects (browsing docs directory).",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "illuminate/filesystem": "^10.0|^11.0|^12.0",
    "illuminate/view": "^10.0|^11.0|^12.0",
    "illuminate/routing": "^10.0|^11.0|^12.0",
    "illuminate/http": "^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Orbit\\DevDocsViewer\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Orbit\\DevDocsViewer\\DocsViewerServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
